# The pins of what the MS-DOS 4.00 build takes in (crates/dos_images).
# fetch-inputs.sh fetches each input and fails unless it is the one pinned
# here; the tool names the pins in its report and on the disks it makes;
# the Pages workflow keys its cache of the tool's output on this file.
#
# One NAME=value a line, the name of capitals, digits and underscores, the
# value of letters, digits and . - _ / : alone: a shell sources the file as
# it is, and the tool reads it as text and refuses any other line
# (src/pins.rs).

# FreeDOS 1.4, the build host, from its Floppy Edition: the 1.44 MB boot
# floppy. It runs the build and is never published.
FREEDOS_ZIP_URL=https://download.freedos.org/1.4/FD14-FloppyEdition.zip
FREEDOS_ZIP_SHA256=45b1fa7c52dd996c3bfa5e352ffcd410781b952a6ad629f15a4c9ec4bbaefc5a
FREEDOS_BOOT=144m/x86BOOT.img
FREEDOS_BOOT_SHA256=552f7cbb0625960c050a3e682a4d2121cc2ffdfa9dc9d592ccd49edf179333dc

# MS-DOS 4.00's source, which Microsoft and IBM published under the MIT
# License, as the community restored it: the directory v4.0 of this commit.
# The commit is the pin (GitHub promises no stable archive checksums), and
# the git tree of v4.0 is checked as well.
MSDOS_REPOSITORY=https://github.com/lotharsm/MS-DOS
MSDOS_BRANCH=dos-4.00-reconstructed
MSDOS_COMMIT=500867d1cc1463e32f8bfd46884fb5547513836b
MSDOS_TREE=9c2a620bf54387b4d719d04b392098541f6143fb

# Doom8088's release v20260304: its Mode 13h build, the shareware WAD it
# ships and its README, from the release's zip; and the GPL-2.0 text, the
# repository's LICENSE at the commit of the tag.
DOOM8088_REPOSITORY=https://github.com/FrenkelS/Doom8088
